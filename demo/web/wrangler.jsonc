{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "duck-trader",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-21",
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist",
    "not_found_handling": "single-page-application",
  },
  "routes": [
    {
      "pattern": "duck-trader.jetsquirrel.cloud",
      "custom_domain": true,
    },
  ],
}
